# SALIN ke .env (lokal) dan isi di Vercel → Settings → Environment Variables. JANGAN PERNAH commit .env / membagikannya (zip, chat, screenshot).
# Bila rahasia pernah bocor: rotasi dulu (Supabase service_role key, API key Betabotz, webhook secret), baru bersihkan history git.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Betabotz Paygate (HANYA server, JANGAN pakai prefix VITE_) ──
# API key milik Payment Method di dashboard https://web.btzpay.my.id
BETABOTZ_API_KEY=
# Rahasia acak untuk URL callback (mis. `openssl rand -hex 32`). Dipasang di callback_url sebagai ?token=...
BETABOTZ_WEBHOOK_SECRET=
# URL publik situs PRODUKSI (tanpa slash akhir) — dipakai untuk callback_url & return_url.
# Isi dengan domain final (bukan URL preview Vercel) di Environment Variables Vercel.
SITE_URL=https://www.tuyyi.store
# Opsional
# BETABOTZ_BASE_URL=https://web.btzpay.my.id
# BETABOTZ_PAYMENT_METHOD=qrisgopay   # qrisdana | qrisgopay | qrisorkut | qrisshopeepay (kosong = ikut Payment Method pada API key)
# BETABOTZ_TIMEOUT_MINUTES=30         # 1-60
