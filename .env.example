VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-public-key

# String QRIS statis akun GoPay Merchant kamu (scan QRIS fisik/portal GoBiz-mu sendiri).
# Aman ditaruh sebagai VITE_ karena QRIS statis memang ditujukan untuk dipindai publik.
VITE_QRIS_STATIC_STRING=00020101021126...isi-qris-statis-kamu...6304XXXX

# ── Hanya dipakai backend (folder api/), JANGAN pakai prefix VITE_ agar tidak ikut ke browser ──
# Ambil di Supabase → Project Settings → API → service_role key (bukan anon key!)
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# Seed awal sesi GoBiz — hasil dari `node scripts/login-gobiz.mjs` (sekali jalan, lokal).
# Setelah baris pertama tersimpan di tabel gobiz_session, dua ini jadi cadangan saja.
GOPAY_TOKEN=
GOPAY_MERCHANT_ID=
