# Salin ke bot/.env (jangan di-commit). Nilainya sama dengan env di Vercel.
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Opsional: cadangan OTP lewat WhatsApp Cloud API (Meta) ──────────────────────────────
# Dipakai HANYA untuk kode OTP saat Baileys mati/gagal. Kosongkan untuk menonaktifkan.
# Butuh nomor di WhatsApp Business Platform + template kategori "Authentication" yang sudah disetujui.
# WA_CLOUD_TOKEN=            # token akses permanen (System User) — RAHASIA
# WA_CLOUD_PHONE_ID=         # Phone number ID dari WhatsApp Manager
# WA_CLOUD_OTP_TEMPLATE=     # nama template, mis. tuyyi_otp (1 variabel kode di body)
# WA_CLOUD_OTP_LANG=id       # kode bahasa template
# WA_CLOUD_OTP_BUTTON=true   # "false" bila template tanpa tombol salin-kode
# WA_CLOUD_API_VERSION=v21.0
